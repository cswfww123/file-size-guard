{
  "description": "file-size-guard: blocks oversized Java / mapper XML at git commit time",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check-commit.py\"",
            "timeout": 20,
            "statusMessage": "file-size-guard: 检查文件体积…"
          }
        ]
      }
    ]
  }
}
